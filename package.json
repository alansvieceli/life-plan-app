{
  "name": "life-plan-app",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "dup": "npx --yes jscpd src --min-tokens 50 --threshold 5",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "biome:ci": "biome ci . --error-on-warnings",
    "knip": "knip --treat-config-hints-as-errors",
    "knip:production": "knip --production --strict --treat-config-hints-as-errors",
    "check": "npm run biome:ci && npm run typecheck && npm run test:coverage && npm run knip && npm run knip:production",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.12",
    "expo-crypto": "~56.0.5",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.7",
    "typescript": "~6.0.3"
  }
}
